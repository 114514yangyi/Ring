  "cards": [
    {
      "dot": "cyan",
      "title": "实时主链路",
      "items": [
        "戒指原始帧 → RealtimeWritingStateHandler → Touch Detector",
        "事件经 ImuBus 发布到 writing_state / writing_state_frame",
        "字符识别只消费 valid_operation=true 的帧或时间段"
      ]
    },
    {
      "dot": "emerald",
      "title": "检测器输入契约",
      "items": [
        "六通道顺序固定:lin_acc_x/y/z, gyro_x/y/z",
        "窗口 20 帧(0.1 s),四分类 contact / air / lift / press",
        "只有 press 与 lift 被解码为 writing_start / pen_up 事件"
      ]
    },
    {
      "dot": "violet",
      "title": "离线训练与产物",
      "items": [
        "数据发现与切窗在 paper_dataset.py,按用户无重叠划分 train/val/test",
        "训练入口 train_paper_touch.py 输出 checkpoint 与 report.json 到 models/",
        "运行时由 paper_touch.py 的 load_touch_classifier 加载模型产物"
      ]
    }
  ]

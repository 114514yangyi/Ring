      "stage": 0,
      "row": 0,
      "width": 150
    },
    {
      "id": "discover",
      "type": "backend",
      "label": "discover_samples",
      "sublabel": "扫描样本目录",
      "stage": 1,
      "row": 0,
      "tag": "paper_dataset.py"
    },
    {
      "id": "windows",
      "type": "backend",
      "label": "window_labels",
      "sublabel": "20 帧滑窗 · 4 类",
      "stage": 2,
      "row": 0,
      "tag": "paper_dataset.py"
    },
    {
      "id": "dataset",
      "type": "backend",

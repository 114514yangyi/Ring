    },
    {
      "id": "report",
      "type": "database",
      "label": "paper_touch_report",
      "sublabel": "history + test 指标",
      "stage": 4,
      "row": 1
    },
    {
      "id": "checkpoint",
      "type": "database",
      "label": "paper_touch_resnet",
      "sublabel": "最优 epoch 权重",
      "stage": 4,
      "row": 2
    }
  ],
  "flows": [
    {
      "from": "clean_data",
      "to": "discover",
      "label": "读取样本",
      "variant": "emphasis"
    },
    {
      "from": "discover",
      "to": "windows",
      "label": "mask 序列"
    },
    {
      "from": "windows",
      "to": "dataset",
      "label": "窗口 + 标签",
      "variant": "emphasis"
    },
    {
      "from": "dataset",
      "to": "model",
      "label": "batch 20x6",
      "variant": "emphasis",
      "labelAt": [
        745,
        200
      ]
    },
    {
      "from": "model",
      "to": "evaluate",
      "label": "val / test logits",
      "variant": "emphasis"
    },
    {
      "from": "model",
      "to": "checkpoint",
      "label": "最优权重"
    },
    {
      "from": "evaluate",
      "to": "report",
      "label": "指标写入",
      "variant": "emphasis",
      "labelAt": [
        960,
        200
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "数据与划分",
      "items": [
        "样本位于 clean_data_delete_g:user_*/{action}/*_x.npy + *_mask.npy",
        "default_user_split 保证 train / val / test 用户无重叠",
        "window_labels 由窗口首尾接触状态决定四分类标签"
      ]
    },
    {
      "dot": "emerald",
      "title": "归一化与模型",
      "items": [
        "compute_normalization 只用训练集帧统计六通道均值 / 方差",
        "每个窗口 20x6,输入 1-D ResNet(通道 8/16/32)四分类 head",
        "paper_touch.py 只把 press 与 lift 解码为书写起止事件"
      ]
    },
    {
      "dot": "violet",
      "title": "评估与产物",
      "items": [
        "报告含 accuracy / macro F1 / press-lift 事件 F1 与混淆矩阵",
        "checkpoint 与 report.json 落盘到 models/",
        "README 记录当前 test accuracy 0.8829 / macro F1 0.8832 / 事件 F1 0.9072"
      ]
    }
  ]
}